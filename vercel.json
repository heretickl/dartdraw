{
  "regions": ["sin1"],
  "functions": {
    "api/score/[action].js": { "includeFiles": "{app.html,render.js,results-engine.js,offline.js,i18n/app.en.js,i18n/print.en.js,i18n/errors.en.js,i18n/app-i18n.js,bracket-print.js,tournament-sanitize.js,pods.js,pods-ui.js,admin-ui.js,players-ui.js,qr.js,boardplan.js,boardplan-ui.js}" },
    "api/tournaments/[id].js": { "includeFiles": "{app.html,render.js,results-engine.js,offline.js,i18n/app.en.js,i18n/print.en.js,i18n/errors.en.js,i18n/app-i18n.js,bracket-print.js,tournament-sanitize.js,pods.js,pods-ui.js,admin-ui.js,players-ui.js,qr.js,boardplan.js,boardplan-ui.js}" }
  },
  "redirects": [
    { "source": "/viewer/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/score/:token", "destination": "/score.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/ms", "destination": "/ms/index.html" },
    { "source": "/ms/features", "destination": "/ms/features.html" },
    { "source": "/ms/how-it-works", "destination": "/ms/how-it-works.html" },
    { "source": "/ms/help", "destination": "/ms/help.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/verify.html", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/reset.html", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/score/:token", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/login.html", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/register.html", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/forgot.html", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/app", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/app.html", "headers": [
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
