{
  "regions": ["sin1"],
  "redirects": [
    { "source": "/viewer/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/verify.html", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/reset.html", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
