# Neon pooled connection string (Neon console -> Connection Details -> "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/dartdraw?sslmode=require

# Long random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Shared code required to create an organizer account. Pick your own value
# and share it only with people who should be able to sign up.
SIGNUP_CODE=replace-with-a-code-you-choose

# Set to "true" to bypass login entirely - every visitor shares one implicit
# "Public" account and all tournaments are visible/editable by anyone. Leave
# unset (or "false") to require organizer login. Redeploy after changing this.
AUTH_DISABLED=false
