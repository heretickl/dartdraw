# Neon pooled connection string (Neon console -> Connection Details -> "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/dartdraw?sslmode=require

# Long random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public address of this app, no trailing slash. Used to build the links in
# verification and password-reset emails. Required in production.
APP_URL=https://dartdraw.vercel.app

# Open sign-up. Stays closed unless this is "true" AND email is configured
# (see below). Admin-created accounts do not need it.
SIGNUP_OPEN=false

# Email provider: "resend" (default) or "console" (writes the message and its
# link to the server log; for development only).
MAIL_PROVIDER=resend
# Resend API key and the sender address (the domain must be verified in Resend).
RESEND_API_KEY=
MAIL_FROM=DartDraw <noreply@your-domain.example>

# Address of the separate public results site (the "viewer" Vercel project),
# no trailing slash. Used only to build the shareable link in Manage Tournament.
VIEWER_URL=https://dartdraw-results.vercel.app

# Login is OFF by default: every visitor shares one implicit "Public" account
# and all tournaments are visible/editable by anyone with the URL. Set this to
# "true" to require organizer login instead. Redeploy after changing this.
REQUIRE_LOGIN=false
